PORT=5000
NODE_ENV=development

MONGO_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

FRONTEND_URL=http://localhost:3000

# For Gmail: use smtp.gmail.com:465, your Gmail address, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Separate GitHub repository integration OAuth App (read-only product flows)
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_CALLBACK_URL=http://localhost:5000/api/github/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional server-side AI chat provider. Local development defaults to Ollama.
AI_PROVIDER=ollama
AI_MODEL=qwen3:1.7b
# Required only when AI_PROVIDER=openai
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_LENGTH=20000
AI_MAX_OUTPUT_LENGTH=40000
AI_MAX_OUTPUT_TOKENS=2048

REDIS_URL=redis://localhost:6379

# Billing and Subscriptions
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
API_KEY_HASH_PEPPER=
